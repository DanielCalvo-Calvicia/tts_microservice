# Copy to .env and adjust. No secrets belong in this file.
SERVICE_NAME=TTS Microservice
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8002
LOG_LEVEL=INFO
# Speech speed in words per minute
TTS_SPEECH_RATE=140
# Preferred voice: used if its name contains this text, otherwise the first English voice
TTS_VOICE_NAME=Zira
