# Copy to .env and adjust. No secrets belong in this file.
SERVICE_NAME=TTS Microservice
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8002
LOG_LEVEL=INFO

# Engine: piper (neural human voice, default), espeak (formant synthesizer: a real machine voice) or pyttsx3
# (the old Windows SAPI / espeak voice). If the Piper voice or espeak is missing or cannot load, the service
# logs an error and uses pyttsx3.
TTS_ENGINE=piper
# espeak only: the program to run. Empty = espeak-ng if installed, else espeak (Debian: sudo apt install espeak-ng)
TTS_ESPEAK_COMMAND=
# espeak only: voice and variant (en, en+m3, en+klatt3, en+croak ...). `espeak --voices` lists them
TTS_ESPEAK_VOICE=en
# espeak only: speed in words per minute (80-390)
TTS_ESPEAK_SPEED=150
# espeak only: pitch 0-99 (lower is deeper)
TTS_ESPEAK_PITCH=30
# espeak only: extra silence between words in milliseconds (a clipped, mechanical rhythm)
TTS_ESPEAK_WORD_GAP_MS=20
# espeak only: robot effect strength (ring modulation, sample hold, bit crush): 0 = off, 1 = default, 3 = maximum
TTS_ROBOT_EFFECT=1.0
# Piper voice name. The deployment tool fetches it (scripts/fetch_voice.py, about 60 MB); by hand: python scripts/fetch_voice.py
TTS_PIPER_VOICE=en_GB-alan-medium
# Folder holding <voice>.onnx and <voice>.onnx.json (relative to the service folder)
TTS_PIPER_MODEL_DIR=models
# Piper speaking speed multiplier (1.0 = the voice's own pace, 1.1 = a little brisker)
TTS_PIPER_SPEED=1.0
# Piper pitch lift in semitones (0 = the voice as recorded). The pace is kept
TTS_PITCH_SEMITONES=2.0
# Piper droid effect strength: 0 = off, 0.5 = light metal (default), 1 = obvious, 2 = maximum
TTS_DROID_EFFECT=0.5

# pyttsx3 only: speech speed in words per minute
TTS_SPEECH_RATE=140
# pyttsx3 only: preferred voice, used if its name contains this text, otherwise the first English voice
TTS_VOICE_NAME=Zira
