# Copy to .env and adjust. No secrets belong in this file.
SERVICE_NAME=TTS Microservice
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8002
LOG_LEVEL=INFO

# Engine: piper (neural voice, default) or pyttsx3 (the old Windows SAPI / espeak voice).
# If the Piper voice is missing or cannot load, the service logs an error and uses pyttsx3.
TTS_ENGINE=piper
# Piper voice name. The deployment tool fetches it (scripts/fetch_voice.py, about 60 MB); by hand: python scripts/fetch_voice.py
TTS_PIPER_VOICE=en_GB-alan-medium
# Folder holding <voice>.onnx and <voice>.onnx.json (relative to the service folder)
TTS_PIPER_MODEL_DIR=models
# Piper speaking speed multiplier (1.0 = the voice's own pace, 1.1 = a little brisker)
TTS_PIPER_SPEED=1.0
# Piper pitch lift in semitones (0 = the voice as recorded). The pace is kept
TTS_PITCH_SEMITONES=2.0
# Piper droid effect strength: 0 = off, 0.5 = light metal (default), 1 = obvious, 2 = maximum
TTS_DROID_EFFECT=0.5

# pyttsx3 only: speech speed in words per minute
TTS_SPEECH_RATE=140
# pyttsx3 only: preferred voice, used if its name contains this text, otherwise the first English voice
TTS_VOICE_NAME=Zira
